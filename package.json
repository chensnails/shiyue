{
  "name": "shiyue",
  "version": "2.2.0",
  "private": true,
  "description": "拾阅（shiyue）—— RSS 驱动的资源卡片站与每日 AI 简报，数据存 PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:ui": "node tests/ui/build.mjs && node tests/ui/ui-regression.cjs",
    "test:server": "node tests/server/dockerfile-files.cjs && node --test \"tests/server/*.test.js\"",
    "test": "node tests/ui/build.mjs && node tests/ui/ui-regression.cjs && node tests/server/dockerfile-files.cjs && node --test \"tests/server/*.test.js\""
  },
  "dependencies": {
    "pg": "^8.23.1",
    "undici": "^8.12.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.12",
    "jsdom": "^30.1.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
